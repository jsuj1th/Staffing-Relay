#!/bin/bash
# Provisions the box at first boot: installs Docker + Compose + cron, writes the
# compose file and a re-runnable deploy script, and installs the SMS cron job.
# The app itself is started by deploy.sh (run by scripts/deploy-singlebox.sh
# from your laptop, after the image is pushed to ECR).
set -euxo pipefail

dnf update -y
dnf install -y docker cronie
systemctl enable --now docker
systemctl enable --now crond

# Docker Compose v2 plugin
mkdir -p /usr/local/lib/docker/cli-plugins
curl -sSL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

mkdir -p /opt/relay

# Compose file — image is pinned by Terraform to the ECR repo :latest tag.
cat > /opt/relay/docker-compose.yml <<'YAML'
services:
  web:
    image: ${ecr_image}
    restart: unless-stopped
    env_file: .env
    ports:
      - "80:8000"
YAML

# Re-runnable deploy: rebuild .env from SSM secrets, pull the newest image,
# restart, migrate. Called on every deploy.
cat > /opt/relay/deploy.sh <<'DEPLOY'
#!/bin/bash
set -euo pipefail
cd /opt/relay
REGION="${aws_region}"

get() { aws ssm get-parameter --name "$1" --with-decryption --query Parameter.Value --output text --region "$REGION"; }

SECRET_KEY=$(get /relay/prod/secret_key)
DATABASE_URL=$(get /relay/prod/database_url)
TELNYX_API_KEY=$(get /relay/prod/telnyx_api_key)
TELNYX_PUBLIC_KEY=$(get /relay/prod/telnyx_public_key)
TELNYX_PHONE_NUMBER=$(get /relay/prod/telnyx_phone_number)

cat > .env <<ENV
DJANGO_SETTINGS_MODULE=lms.settings.singlebox
DEBUG=False
ALLOWED_HOSTS=${allowed_hosts}
SECRET_KEY=$SECRET_KEY
DATABASE_URL=$DATABASE_URL
REDIS_URL=redis://localhost:6379/0
TELNYX_API_KEY=$TELNYX_API_KEY
TELNYX_PUBLIC_KEY=$TELNYX_PUBLIC_KEY
TELNYX_PHONE_NUMBER=$TELNYX_PHONE_NUMBER
SMS_DEBUG=false
ENV
chmod 600 .env

aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin ${ecr_registry}
docker compose pull
docker compose up -d
docker compose run --rm web python manage.py migrate --noinput
DEPLOY
chmod +x /opt/relay/deploy.sh

# Flush batched SMS every 10 minutes (replaces Celery beat).
cat > /etc/cron.d/relay-sms <<'CRON'
*/10 * * * * root cd /opt/relay && /usr/bin/docker compose exec -T web python manage.py send_pending_sms >> /var/log/relay-sms.log 2>&1
CRON
chmod 644 /etc/cron.d/relay-sms
